# ==============================================================================
# PITSTOP JUDICIAL / LEGAL TELEMETRY - VARIABLES DE ENTORNO
# Copia este archivo a .env.local para desarrollo local o configura en Vercel Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de Datos PostgreSQL en la Nube)
# Obtén estos valores en: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui

# ------------------------------------------------------------------------------
# 2. RACE CONTROL CRON & SEGURIDAD
# Token secreto para autorizar las ejecuciones de /api/cron/check-updates
# ------------------------------------------------------------------------------
CRON_SECRET=pitstop_telemetry_secure_cron_secret_2026

# ------------------------------------------------------------------------------
# 3. CANAL DIRECTO DE WHATSAPP (DESTINATARIO PRINCIPAL)
# Número de teléfono del jefe / despacho judicial en formato internacional
# ------------------------------------------------------------------------------
WHATSAPP_TARGET_NUMBER=+573196816770
WHATSAPP_API_TOKEN=tu-token-de-meta-o-twilio-opcional

# ------------------------------------------------------------------------------
# 4. ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV=production
